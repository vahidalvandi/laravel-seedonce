{
    "name": "vahidalvandi/laravel-seedonce",
    "description": "Laravel package to run seeders only once",
    "type": "library",
    "require": {
        "php": "^7.2|^8.0",
        "illuminate/database": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^3.8|^4.0|^5.0|^6.0|^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "vahidalvandi\\SeedOnce\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "vahidalvandi\\SeedOnce\\Test\\": "tests"
        },
        "classmap": [
            "tests/database/seeds"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "vahidalvandi\\SeedOnce\\SeedOnceServiceProvider"
            ]
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "vahid alvandi",
            "email": "va6893@gmail.com",
            "homepage": "https://webine.ir",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "./vendor/bin/phpunit"
        ]
    }
}
